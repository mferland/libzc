#!/bin/sh

set -eu

test_srcdir=$(dirname "$0")
tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/yazc-cli.XXXXXX")
trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM

"$YAZC" --help >"$tmpdir/help.out" 2>"$tmpdir/help.err"
grep -q "Commands:" "$tmpdir/help.out"

"$YAZC" --version >"$tmpdir/version.out" 2>"$tmpdir/version.err"
grep -q "^yazc " "$tmpdir/version.err"

if "$YAZC" >"$tmpdir/missing.out" 2>"$tmpdir/missing.err"; then
	echo "yazc accepted a missing command" >&2
	exit 1
fi
grep -q "^error: missing command" "$tmpdir/missing.err"

if "$YAZC" invalid >"$tmpdir/invalid.out" 2>"$tmpdir/invalid.err"; then
	echo "yazc accepted an invalid command" >&2
	exit 1
fi
grep -q "invalid command" "$tmpdir/invalid.err"

if ZC_LOG=0 "$YAZC" info "$tmpdir/missing.zip" \
	>"$tmpdir/log-off.out" 2>"$tmpdir/log-off.err"; then
	echo "yazc opened a missing zip file" >&2
	exit 1
fi
if grep -q "^yazc:" "$tmpdir/log-off.err"; then
	echo "ZC_LOG=0 did not suppress engine logging" >&2
	exit 1
fi
grep -q "^error: zc_zip_open() failed" "$tmpdir/log-off.err"

if ZC_LOG=err "$YAZC" info "$tmpdir/missing.zip" \
	>"$tmpdir/log-error.out" 2>"$tmpdir/log-error.err"; then
	echo "yazc opened a missing zip file" >&2
	exit 1
fi
config_h=$(dirname "$YAZC")/../config.h
if grep -q "^#define ENABLE_LOGGING 1" "$config_h"; then
	grep -q "^yazc: zc_zip_open: fopen" "$tmpdir/log-error.err"
elif grep -q "^yazc:" "$tmpdir/log-error.err"; then
	echo "engine logging was not disabled" >&2
	exit 1
fi

"$YAZC" info "$test_srcdir/noradi.zip" >"$tmpdir/info.out" 2>"$tmpdir/info.err"
grep -q "^INDEX NAME" "$tmpdir/info.out"

"$YAZC" dictionary -d "$test_srcdir/dict.txt" "$test_srcdir/noradi.zip" \
	>"$tmpdir/dictionary.out" 2>"$tmpdir/dictionary.err"
grep -q "Password is: noradi" "$tmpdir/dictionary.out"

"$YAZC" bruteforce -S -c a -l 1 "$test_srcdir/bruteforce_one_char.zip" \
	>"$tmpdir/bruteforce.out" 2>"$tmpdir/bruteforce.err"
grep -q '^Minimum length: 1$' "$tmpdir/bruteforce.out"
grep -q "Password is: a" "$tmpdir/bruteforce.out"

if "$YAZC" bruteforce -S -c a --min-length 2 -l 2 \
	"$test_srcdir/bruteforce_one_char.zip" \
	>"$tmpdir/bruteforce-min.out" 2>"$tmpdir/bruteforce-min.err"; then
	echo "bruteforce searched below its minimum length" >&2
	exit 1
fi
grep -q '^Minimum length: 2$' "$tmpdir/bruteforce-min.out"
grep -q '^Password not found$' "$tmpdir/bruteforce-min.out"

"$YAZC" bruteforce -S -a -A -n -s -l 1 \
	"$test_srcdir/bruteforce_one_char.zip" \
	>"$tmpdir/bruteforce-classes.out" 2>"$tmpdir/bruteforce-classes.err"
charset=$(sed -n 's/^Character set: //p' "$tmpdir/bruteforce-classes.out")
test "${#charset}" -eq 95
printf '%s\n' "$charset" | grep -Fq '0123456789'
printf '%s\n' "$charset" | grep -Fq 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
printf '%s\n' "$charset" | grep -Fq 'abcdefghijklmnopqrstuvwxyz'
grep -q '^Password is: a$' "$tmpdir/bruteforce-classes.out"

"$YAZC" vulkan --help >"$tmpdir/vulkan-help.out" \
	2>"$tmpdir/vulkan-help.err"
grep -q -- "--list-devices" "$tmpdir/vulkan-help.err"
grep -q -- "--alpha" "$tmpdir/vulkan-help.err"
grep -q -- "--alpha-caps" "$tmpdir/vulkan-help.err"
grep -q -- "--numeric" "$tmpdir/vulkan-help.err"
grep -q -- "--special" "$tmpdir/vulkan-help.err"

if "$YAZC" vulkan -c a --min-length 1 \
	"$test_srcdir/bruteforce_one_char.zip" \
	>"$tmpdir/vulkan-length.out" 2>"$tmpdir/vulkan-length.err"; then
	echo "vulkan accepted a missing --length" >&2
	exit 1
fi
grep -q -- "--length is required" "$tmpdir/vulkan-length.err"

if "$YAZC" vulkan -c a -l 1 --min-length 2 \
	"$test_srcdir/bruteforce_one_char.zip" \
	>"$tmpdir/vulkan-range.out" 2>"$tmpdir/vulkan-range.err"; then
	echo "vulkan accepted an inverted length range" >&2
	exit 1
fi
grep -q -- "minimum length must not exceed maximum length" \
	"$tmpdir/vulkan-range.err"
